### Variables
@baseUrl = http://localhost:3000
@contentType = application/json

#The basic request
# GET {{baseUrl}}

### get all tasks
GET {{baseUrl}}/tasks

### wrong UUID format
GET {{baseUrl}}/tasks/1

### not found
GET {{baseUrl}}/tasks/fd63d764-d961-4c28-82fa-b9c90fdedb70

### found task
GET {{baseUrl}}/tasks/fd63d764-d961-4c28-82fa-b9c90fdedb71

### create new task
POST {{baseUrl}}/tasks
Content-Type: {{contentType}}

{
  "title": "Learn NestJS",
  "description": "Complete the NestJS course",
  "status": "OPEN"
}

### validation error = status is incorrect
POST {{baseUrl}}/tasks
Content-Type: {{contentType}}

{
  "title": null,
  "description": "Complete the NestJS course",
  "status": "XXX"
}

### update task status
PATCH {{baseUrl}}/tasks/fd63d764-d961-4c28-82fa-b9c90fdedb71
Content-Type: {{contentType}}

{
  "status": "IN_PROGRESS"
}

### delete task
DELETE {{baseUrl}}/tasks/b1acf4e8-3b76-4801-a7a9-f8ca0da59fd7